{
  "search": {
    "backend": "optuna",
    "metric": "uar",
    "direction": "maximize",
    "n_trials": 100,
    "sampler": "TPE",
    "pruner": "median",
    "n_jobs": 1,
    "timeout": null,
    "random_state": 42
  },
  "param_space": {
    "clf__n_estimators":     { "type": "int",         "low": 100,  "high": 600               },
    "clf__max_depth":        { "type": "categorical",  "choices": [null, 5, 10, 20]           },
    "clf__min_samples_split":{ "type": "int",         "low": 2,    "high": 10                },
    "clf__min_samples_leaf": { "type": "int",         "low": 1,    "high": 5                 },
    "clf__max_features":     { "type": "float",       "low": 0.1,  "high": 1.0               },
    "clf__max_samples":      { "type": "float",       "low": 0.5,  "high": 1.0               },
    "clf__criterion":        { "type": "categorical",  "choices": ["gini", "entropy"]         },
    "clf__class_weight":     { "type": "categorical",  "choices": ["balanced", null]          },
    "mfcc__n_mfcc":          { "type": "int",         "low": 13,   "high": 40                },
    "vocaltract__lp_order":  { "type": "categorical",  "choices": [8, 10, 12, 16]            }
  }
}
