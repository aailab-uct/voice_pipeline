{
  "output": {
    "out_dir": "dataset",
    "metadata_csv": "dataset/metadata.csv"
  },

  "filtering": {
    "min_age": 18
  },

  "f0": {
    "ranges": {
      "m": [75.0, 300.0],
      "f": [100.0, 600.0]
    },
    "default_range": [60.0, 250.0]
  },

  "signal_normalization": {
    "target_rms": 0.1,
    "min_rms": 1e-6,
    "trim_top_db": 20
  },

  "datasets": {
    "SVD": {
      "root": "data/SVD",
      "metadata_csv": "data/SVD/svd_information.csv",
      "session_ids_to_delete": [87, 713, 1372, 1573, 2070, 2077, 2081, 2088, 2426, 2428, 2448, 2450, 2451, 2457]
    },
    "PVQD": {
      "root": "data/PVQD",
      "demographics_xlsx": "data/PVQD/Demographics.xlsx",
      "trim_top_db": 15
    },
    "VOICED": {
      "root": "data/VOICED",
      "trim_top_db": 15,
      "frame_length_factor": 256,
      "hop_length_factor": 65,
      "reference_fs": 50000
    },
    "AVFAD": {
      "root": "data/AVFAD",
      "xlsx": "data/AVFAD/AVFAD_01_00_00.xlsx",
      "sheet": "AVFAD",
      "crop_to_one_rep": true,
      "noise_est_s": 0.1,
      "silence_ratio": 0.3,
      "min_pause_s": 0.15,
      "min_rep_s": 0.5,
      "window_s": 0.05,
      "files": {
        "001": "i",
        "002": "a",
        "003": "u"
      }
    }
  }
}
